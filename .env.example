# All keys are optional for the demo path (cached fixtures need zero keys).

# PyAI (speech: transcription + TTS).
# Leave unset and `npm start` mints a free sandbox key automatically
# (stored in sandbox.pyai_key, gitignored). Sandbox keys expire ~7 days;
# expired ones are re-minted automatically.
#PYAI_API_KEY=

# Anthropic (extraction LLM). Required only to run extraction on new audio.
# Not free and not auto-mintable — see README.
#ANTHROPIC_API_KEY=
