{
  "name": "opengong-lite",
  "version": "0.0.1",
  "description": "Open-source call notes with claim-level receipts: every claim points to the exact transcript line.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "demo": "node src/server.js",
    "test": "node --test",
    "extract": "node src/extract.js --fixture stereo",
    "run": "node src/extract.js --fixture stereo",
    "scorecard": "node scripts/scorecard.mjs",
    "control-room": "node scripts/control-room.mjs",
    "build:deal": "node scripts/build-deal-index.mjs",
    "demo:deal": "node scripts/build-deal-index.mjs && node src/deal-server.mjs",
    "coach": "node src/methodology/cli.js",
    "coach:demo": "node src/methodology/cli.js score samples/methodology/call-discovery.txt"
  }
}
